# Copy this file to .env and fill in your Kie.ai API key.
# This file is used by both the Node.js and PHP 8.5 deployments.
KIE_API_KEY=
KIE_IMAGE_MODEL=nano-banana-pro
KIE_BASE_URL=https://api.kie.ai
# Kie.ai file upload endpoint. The app uploads images directly here;
# PUBLIC_BASE_URL is not required in the current version.
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
PORT=8787
# Адрес отправителя для PHP-варианта на хостинге.
MAIL_FROM=no-reply@example.com
MAIL_SUBJECT=Ваша карьерная открытка
